# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin login (username "admin" maps to this email)
NEXT_PUBLIC_ADMIN_EMAIL=admin@obkladerie.cz
ADMIN_EMAIL=admin@obkladerie.cz

# Public site URL (sitemap / robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: allow cookie stub auth when Supabase env is missing
# ENABLE_STUB_AUTH=true
# NEXT_PUBLIC_ENABLE_STUB_AUTH=true

# Optional: e-mail notifications for new inquiries (Resend)
# RESEND_API_KEY=re_xxx
# INQUIRY_NOTIFY_EMAIL=admin@obkladerie.cz
# INQUIRY_FROM_EMAIL=Obkladérie <onboarding@resend.dev>
